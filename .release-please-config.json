{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "✨ 新功能"
        },
        {
          "type": "fix",
          "section": "🐛 错误修复"
        },
        {
          "type": "perf",
          "section": "⚡ 性能优化"
        },
        {
          "type": "refactor",
          "section": "♻️ 代码重构"
        },
        {
          "type": "docs",
          "section": "📝 文档"
        },
        {
          "type": "style",
          "section": "💄 代码格式"
        },
        {
          "type": "test",
          "section": "✅ 测试"
        },
        {
          "type": "build",
          "section": "📦 构建"
        },
        {
          "type": "ci",
          "section": "🎡 持续集成"
        },
        {
          "type": "chore",
          "section": "🔧 杂项"
        }
      ]
    }
  }
}