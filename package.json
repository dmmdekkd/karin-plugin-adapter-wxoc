{
  "name": "karin-plugin-adapter-wxoc",
  "version": "1.0.1",
  "author": "dmmdekkd",
  "type": "module",
  "description": "Karin 微信个人号适配器 基于 ilink 协议",
  "homepage": "https://github.com/dmmdekkd/karin-plugin-adapter-wxoc",
  "bugs": {
    "url": "https://github.com/dmmdekkd/karin-plugin-adapter-wxoc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmmdekkd/karin-plugin-adapter-wxoc.git"
  },
  "keywords": [
    "karin",
    "karin-plugin",
    "wechat",
    "weixin",
    "ilink",
    "adapter"
  ],
  "main": "dist/index.js",
  "karin": {
    "main": "src/index.ts",
    "web": "./dist/web.config.js",
    "ts-web": "./src/web.config.ts",
    "apps": [
      "dist/apps"
    ],
    "ts-apps": [
      "src/apps"
    ],
    "static": [
      "resources"
    ],
    "files": [
      "config",
      "data",
      "resources"
    ]
  },
  "files": [
    "/dist/**/*.js",
    "/dist/**/*.d.ts",
    "/config/*.json",
    "resources",
    "CHANGELOG.md",
    "!dist/app.js",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@karinjs/plugin-shotium": "^0.3.2",
    "@ys7zts/karin-plugin-nekostatus": "^1.4.13",
    "karin-plugin-botweb": "^1.0.15",
    "karin-plugin-ling": "^1.34.8",
    "karin-plugin-qbot": "^1.0.11",
    "qrcode": "^1.5.4"
  }
}