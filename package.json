{
  "name": "karin-plugin-adapter-wxoc",
  "version": "1.0.2",
  "author": "dmmdekkd",
  "type": "module",
  "description": "Karin 微信Claw适配器 基于 ilink 协议",
  "homepage": "https://github.com/dmmdekkd/karin-plugin-adapter-wxoc",
  "bugs": {
    "url": "https://github.com/dmmdekkd/karin-plugin-adapter-wxoc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmmdekkd/karin-plugin-adapter-wxoc.git"
  },
  "keywords": [
    "karin",
    "karin-plugin",
    "wechat",
    "weixin",
    "ilink",
    "adapter"
  ],
  "scripts": {
    "app": "node dist/app.js",
    "build": "tsdown",
    "dev": "cross-env EBV_FILE=\"development.env\" node --import tsx src/app.ts",
    "pub": "npm publish --access public"
  },
  "main": "dist/index.js",
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.17.8",
    "@types/node-schedule": "^2.1.8",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^7.0.3",
    "eslint": "^9.7.0",
    "neostandard": "^0.11.9",
    "node-karin": "^1.17.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  },
  "karin": {
    "main": "src/index.ts",
    "web": "./dist/web.config.js",
    "ts-web": "./src/web.config.ts",
    "apps": [
      "dist/apps"
    ],
    "ts-apps": [
      "src/apps"
    ],
    "static": [
      "resources"
    ],
    "files": [
      "config",
      "data",
      "resources"
    ]
  },
  "files": [
    "/dist/**/*.js",
    "/dist/**/*.d.ts",
    "/config/*.json",
    "resources",
    "CHANGELOG.md",
    "!dist/app.js",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@karinjs/plugin-shotium": "^0.3.2",
    "@ys7zts/karin-plugin-nekostatus": "^1.4.13",
    "karin-plugin-botweb": "^1.0.15",
    "karin-plugin-ling": "^1.34.8",
    "karin-plugin-qbot": "^1.0.11",
    "node-schedule": "2.1.1",
    "qrcode": "^1.5.4"
  }
}